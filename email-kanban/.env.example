# Copy to .env and fill in. .env is git-ignored.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Desktop app)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your-client-secret

# Optional: key used to encrypt locally stored credentials/tokens.
# If unset, a random per-install key is generated on first run.
VITE_STORE_ENCRYPTION_KEY=
